# Google Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for script generation
GEMINI_MODEL=gemini-2.5-flash

# Default TTS voice (see modules/audio_gen.py for full list)
DEFAULT_TTS_VOICE=uz-UZ-MadinaNeural

# Default video ratio: "9:16" (Shorts/vertical) or "16:9" (landscape)
DEFAULT_VIDEO_RATIO=9:16
